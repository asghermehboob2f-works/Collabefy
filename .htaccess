# ==============================================================================
# Collabefy Reverse Proxy Configuration (.htaccess)
# Routes all public domain traffic to the Next.js production server (Port 3000)
# ==============================================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Pass Authorization Header to Next.js and Express API
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Allow ACME Challenge for Let's Encrypt SSL Certificates
RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge/
RewriteRule ^ - [L]

# Try native reverse proxy rule first (if mod_proxy is supported)
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]

# Universal Fallback: If native proxy is not supported by LiteSpeed container, route via index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Fallback for standard Apache / LiteSpeed mod_proxy
<IfModule mod_proxy.c>
ProxyPreserveHost On
ProxyPass / http://127.0.0.1:3000/
ProxyPassReverse / http://127.0.0.1:3000/
</IfModule>

# Server Configuration
PORT=4000
NODE_ENV=production

# Database Configuration (PostgreSQL for Production, SQLite for local dev)
# DATABASE_URL="postgresql://collabefy:securepassword@localhost:5432/collabefy_db?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secrets (Generate secure random 64-char strings in production)
JWT_ACCESS_SECRET="collabefy-jwt-access-secret-2026-prod-secure-token-collabefy-prod"
JWT_REFRESH_SECRET="collabefy-jwt-refresh-secret-2026-prod-secure-token-collabefy-prod"

# CORS and Cookies
FRONTEND_URL="http://localhost:3000"
COOKIE_DOMAIN=""

# Administrator Login Credentials from ENV
ADMIN_EMAIL="admin@collabefy.com"
ADMIN_ID="admin@collabefy.com"
ADMIN_PASSWORD="CollabefyAdmin2026!"

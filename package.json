{
  "name": "collabefy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:frontend": "node node_modules/next/dist/bin/next dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start-all.mjs",
    "stop": "node scripts/stop-all.mjs",
    "restart": "node scripts/restart-all.mjs",
    "start:frontend": "node node_modules/next/dist/bin/next start -p 3000",
    "start:backend": "cd backend && npm start",
    "lint": "node node_modules/next/dist/bin/next lint",
    "lint:fix": "node node_modules/next/dist/bin/next lint --fix",
    "type-check": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test scripts/verify-production.mjs"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^14.2.18",
    "next-auth": "^4.24.15",
    "next-secure-headers": "^2.2.0",
    "prisma": "^7.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}

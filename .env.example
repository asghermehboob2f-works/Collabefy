# Collabefy Production Environment Configuration
# Database Connection (SQLite in development, PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-hex-secret-in-production"

# OAuth Integrations (Optional)
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# Anti-Bot & View Audit Configuration
VIEW_AUDIT_STABILIZATION_HOURS="48"
DISCORD_BOT_TOKEN="your_discord_bot_token"
DISCORD_GUILD_ID="your_discord_guild_id"

# Rate Limiter
RATE_LIMIT_MAX_PER_MINUTE="60"

